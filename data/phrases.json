{
 "scenes": [
  {
   "id": "help",
   "title": "救命短句",
   "intro": "听不懂、不会说的时候,先用这几句。",
   "phrases": [
    {
     "id": "help-1",
     "en": "Sorry, I do not understand.",
     "zh": "对不起,我听不懂。"
    },
    {
     "id": "help-2",
     "en": "Can you say it again?",
     "zh": "你能再说一遍吗?"
    },
    {
     "id": "help-3",
     "en": "Please speak slowly.",
     "zh": "请说慢一点。"
    },
    {
     "id": "help-4",
     "en": "How do you say this in English?",
     "zh": "这个用英语怎么说?"
    },
    {
     "id": "help-5",
     "en": "What does this word mean?",
     "zh": "这个词是什么意思?"
    },
    {
     "id": "help-6",
     "en": "Can you help me?",
     "zh": "你能帮我吗?"
    },
    {
     "id": "help-7",
     "en": "I do not speak much English.",
     "zh": "我英语说得不多。"
    },
    {
     "id": "help-8",
     "en": "Thank you very much.",
     "zh": "非常感谢。"
    }
   ]
  },
  {
   "id": "greet",
   "title": "打招呼",
   "intro": "见面、告别时最常用的话。",
   "phrases": [
    {
     "id": "greet-1",
     "en": "Hello! How are you?",
     "zh": "你好!你好吗?"
    },
    {
     "id": "greet-2",
     "en": "I am fine, thank you. And you?",
     "zh": "我很好,谢谢。你呢?"
    },
    {
     "id": "greet-3",
     "en": "Good morning.",
     "zh": "早上好。"
    },
    {
     "id": "greet-4",
     "en": "Good night.",
     "zh": "晚安。"
    },
    {
     "id": "greet-5",
     "en": "Nice to meet you.",
     "zh": "很高兴认识你。"
    },
    {
     "id": "greet-6",
     "en": "See you tomorrow.",
     "zh": "明天见。"
    },
    {
     "id": "greet-7",
     "en": "Have a good day.",
     "zh": "祝你今天愉快。"
    },
    {
     "id": "greet-8",
     "en": "Long time no see.",
     "zh": "好久不见。"
    }
   ]
  },
  {
