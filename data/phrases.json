     "zh": "你能帮我吗?"
    },
    {
     "id": "help-7",
     "en": "I do not speak much English.",
     "zh": "我英语说得不多。"
    },
    {
     "id": "help-8",
     "en": "Thank you very much.",
     "zh": "非常感谢。"
    }
   ],
   "dialog": [
    {
     "id": "help-d1",
     "who": "A",
     "en": "Sorry, I do not understand.",
     "zh": "对不起,我听不懂。"
    },
    {
     "id": "help-d2",
     "who": "B",
     "en": "No problem. I will speak slowly.",
     "zh": "没关系,我说慢一点。"
    },
    {
     "id": "help-d3",
     "who": "A",
     "en": "Thank you. Can you say it again?",
     "zh": "谢谢。你能再说一遍吗?"
    },
    {
     "id": "help-d4",
     "who": "B",
     "en": "Sure. Where is the station?",
     "zh": "当然。车站在哪里?"
    }
   ]
  },
  {
   "id": "greet",
   "title": "打招呼",
   "intro": "见面、告别时最常用的话。",
   "phrases": [
