  {
   "id": "help",
   "title": "救命短句",
   "intro": "听不懂、不会说的时候,先用这几句。",
   "phrases": [
    {
     "id": "help-1",
     "en": "Sorry, I do not understand.",
     "zh": "对不起,我听不懂。"
    },
    {
     "id": "help-2",
     "en": "Can you say it again?",
     "zh": "你能再说一遍吗?"
    },
    {
